SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Ixtiyoriy — POST scan'larni himoyalash uchun maxfiy token (uzun random string)
INGEST_TOKEN=

# Ixtiyoriy — IMB integratsiya manzillari (default qiymatlar ishlaydi)
IMB_BASE=https://imb.imbtruck.uz
IMB_QWERTY_URL=http://imb.imbtruck.uz/attendance/qwerty/
